<Project>
  <!--
    Shared targets for PyWinRT Python package generation.
    
    Each project must define:
      - PackageName: The Python package name (e.g., winappsdk-Foundation)
      - InputWinMD: ItemGroup with metadata to generate code from
      - ReferenceWinMD: ItemGroup with dependencies for resolution (optional)
      - PythonDependency: ItemGroup with runtime Python package dependencies (optional)
      
    The WindowsSDK reference is automatically added using WinSDKMetadataPath.
    
    Output path properties (ObjPath, PythonPackagePath, etc.) are defined in Directory.Build.props.
    
    Set GeneratePyWinAppSDK=true in your project to enable PyWinAppSDK build targets.
    This allows normal .NET projects to coexist in the same directory without triggering Python package generation.
  -->

  <Target Name="BuildWinMDArguments">
    <!-- Set tool paths that depend on NuGet package properties (must be inside target for proper evaluation) -->
    <PropertyGroup>
      <CppWinRTExe Condition="'$(CppWinRTExe)' == ''">$(PkgMicrosoft_Windows_CppWinRT)\bin\cppwinrt.exe</CppWinRTExe>
      <WinSDKMetadataPath Condition="'$(WinSDKMetadataPath)' == ''">$(PkgMicrosoft_Windows_SDK_CPP)\c\References\$(TargetPlatformVersion)</WinSDKMetadataPath>
      <!-- Check if WindowsSDK is already in ReferenceWinMD -->
      <_HasWinSDKRef>false</_HasWinSDKRef>
      <_HasWinSDKRef Condition="'@(ReferenceWinMD)' != '' and $([System.String]::new('@(ReferenceWinMD)').Contains('$(WinSDKMetadataPath)'))">true</_HasWinSDKRef>
    </PropertyGroup>

    <!-- Always add WindowsSDK as reference (needed for type resolution) -->
    <ItemGroup>
      <ReferenceWinMD Include="$(WinSDKMetadataPath)" Condition="'$(WinSDKMetadataPath)' != '' and '$(_HasWinSDKRef)' != 'true'">
        <PyPackageName>winrt</PyPackageName>
      </ReferenceWinMD>
    </ItemGroup>

    <!-- CppWinRT: -input for InputWinMD, -input/-reference for ReferenceWinMD -->
    <PropertyGroup>
      <CppWinRTInputArgs>@(InputWinMD->'-input "%(Identity)"', ' ')</CppWinRTInputArgs>
      <CppWinRTRefArgs>@(ReferenceWinMD->'-input "%(Identity)"', ' ')</CppWinRTRefArgs>
      <!-- WindowsSDK uses -reference instead of -input -->
      <CppWinRTRefArgs>$(CppWinRTRefArgs.Replace('-input "$(WinSDKMetadataPath)"', '-reference "$(WinSDKMetadataPath)"'))</CppWinRTRefArgs>
    </PropertyGroup>

    <!-- PyWinRT: input and reference use "packagename;path" format -->
    <PropertyGroup>
      <PyWinRTInputArgs>@(InputWinMD->'--input %(PyPackageName);%(Identity)', ' ')</PyWinRTInputArgs>
      <PyWinRTRefArgs>@(ReferenceWinMD->'--reference %(PyPackageName);%(Identity)', ' ')</PyWinRTRefArgs>
    </PropertyGroup>

    <Message Text="CppWinRT Input Args: $(CppWinRTInputArgs)" Importance="high" Condition="'$(CppWinRTInputArgs)' != ''" />
    <Message Text="CppWinRT Ref Args: $(CppWinRTRefArgs)" Importance="high" Condition="'$(CppWinRTRefArgs)' != ''" />
    <Message Text="PyWinRT Input Args: $(PyWinRTInputArgs)" Importance="high" Condition="'$(PyWinRTInputArgs)' != ''" />
    <Message Text="PyWinRT Ref Args: $(PyWinRTRefArgs)" Importance="high" Condition="'$(PyWinRTRefArgs)' != ''" />
  </Target>

  <!-- Diagnostic: list current WinMD items with optional PyPackageName metadata -->
  <Target Name="PrintWinMDs" DependsOnTargets="BuildWinMDArguments">
    <Message Text="=== Input WinMDs (@(InputWinMD->Count())) ===" Importance="high" Condition="'@(InputWinMD)' != ''" />
    <Message Text="  %(InputWinMD.Identity) [PyPackageName=%(InputWinMD.PyPackageName)]" Importance="high" Condition="'@(InputWinMD)' != ''" />
    <Message Text="=== Reference WinMDs (@(ReferenceWinMD->Count())) ===" Importance="high" Condition="'@(ReferenceWinMD)' != ''" />
    <Message Text="  %(ReferenceWinMD.Identity) [PyPackageName=%(ReferenceWinMD.PyPackageName)]" Importance="high" Condition="'@(ReferenceWinMD)' != ''" />
  </Target>



  <!-- Generate PyWinRT Python bindings -->
  <Target Name="GeneratePyWinRT" DependsOnTargets="BuildWinMDArguments">
    <MakeDir Directories="$(PyWinRTOutputPath)" />

    <Message Text="PyWinRT command: $(PyWinRTExe) $(PyWinRTInputArgs) $(PyWinRTRefArgs) --output $(PyWinRTOutputPath) --header-path $(PyWinRTHeaderPath)" Importance="high" />

    <Exec
      Command="$(PyWinRTExe) $(PyWinRTInputArgs) $(PyWinRTRefArgs) --output $(PyWinRTOutputPath) --header-path $(PyWinRTHeaderPath)"
      WorkingDirectory="$(MSBuildProjectDirectory)" />
    
    <!-- Remove generated headers to use the ones from winappsdk-headers package instead -->
    <RemoveDir Directories="$(PyWinRTHeaderPath)" Condition="Exists('$(PyWinRTHeaderPath)')" />
  </Target>

  <!-- Collect namespace names from generated .cpp files -->
  <Target Name="CollectNamespaces" DependsOnTargets="GeneratePyWinRT">
    <ItemGroup>
      <NamespaceCppFile Include="$(PyWinRTOutputPath)\$(PackageName)-*\py.*.cpp" />
    </ItemGroup>

    <!-- Namespaces to exclude (e.g., internal implementation details or broken code generation) -->
    <PropertyGroup>
      <ExcludedNamespaces>;Microsoft.Windows.ApplicationModel.Background.UniversalBGTask;</ExcludedNamespaces>
    </PropertyGroup>

    <!-- Extract namespace from filename: py.Microsoft.UI.cpp -> Microsoft.UI -->
    <ItemGroup Condition="'@(NamespaceCppFile)' != ''">
      <NamespaceTemp Include="@(NamespaceCppFile)">
        <NamespaceValue>$([System.String]::Copy('%(Filename)').Substring(3))</NamespaceValue>
      </NamespaceTemp>
    </ItemGroup>

    <!-- Filter out excluded namespaces by checking clean namespace name -->
    <ItemGroup>
      <Namespace Include="@(NamespaceTemp)" Condition="!$(ExcludedNamespaces.Contains(';%(NamespaceTemp.NamespaceValue);'))" />
    </ItemGroup>

    <Message Text="Found @(Namespace->Count()) namespace(s) (after exclusions):" Importance="high" />
    <Message Text="  - %(Namespace.NamespaceValue)" Importance="high" Condition="'@(Namespace)' != ''" />
  </Target>

  <!-- Merge PyWinRT output files into package directory -->
  <Target Name="MergePyWinRTResults" DependsOnTargets="GeneratePyWinRT;CollectNamespaces">
    <Message Text="==================== MergePyWinRTResults (Staging) ====================" Importance="high" />

    <!-- Define safe package name and ensure destination folders exist -->
    <PropertyGroup>
      <SafePackageName>$(PackageName.Replace('-', '_'))</SafePackageName>
    </PropertyGroup>
    <RemoveDir Directories="$(PythonPackagePath)\_stage" Condition="Exists('$(PythonPackagePath)\_stage')" />
    <MakeDir Directories="$(PythonPackagePath)\winappsdk" />
    <MakeDir Directories="$(PythonPackagePath)\$(SafePackageName)" />

    <!-- Ensure py.typed markers exist for type checkers -->
    <WriteLinesToFile File="$(PythonPackagePath)\winappsdk\py.typed" Lines="" Overwrite="true" />
    <WriteLinesToFile File="$(PythonPackagePath)\$(SafePackageName)\py.typed" Lines="" Overwrite="true" />

    <!-- ========== Copy Generated Python Files ========== -->
    <!-- Copy *.py files to winappsdk namespace using PowerShell script for complex path handling -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ScriptsDirectory)copy-python-namespace.ps1&quot; -PyWinRTOutputPath &quot;$(PyWinRTOutputPath)&quot; -SafePackageName $(SafePackageName) -DestPath &quot;$(PythonPackagePath)\winappsdk&quot;" />
    <Message Text="Copied .py files to winappsdk namespace" Importance="high" />
    
    <!-- Remove microsoft folder from winappsdk_Component after copying to shared namespace -->
    <PropertyGroup>
      <ComponentMicrosoftPath>$(PythonPackagePath)\$(SafePackageName)\microsoft</ComponentMicrosoftPath>
    </PropertyGroup>
    <RemoveDir Directories="$(ComponentMicrosoftPath)" Condition="Exists('$(ComponentMicrosoftPath)')" />

    <!-- ========== Copy Generated C++ and Type Files ========== -->
    <!-- Copy *.cpp files (extension sources) to package root with stripped version folder -->
    <ItemGroup>
      <CppFiles Include="$(PyWinRTOutputPath)\$(PackageName)-*\**\*.cpp">
        <StrippedPath Condition="'%(RecursiveDir)' != '' and $([System.String]::Copy('%(RecursiveDir)').IndexOf('\\')) &gt;= 0">$([System.String]::Copy('%(RecursiveDir)').Substring($([MSBuild]::Add($([System.String]::Copy('%(RecursiveDir)').IndexOf('\\')), 1))))</StrippedPath>
        <StrippedPath Condition="'%(RecursiveDir)' == '' or $([System.String]::Copy('%(RecursiveDir)').IndexOf('\\')) &lt; 0"></StrippedPath>
      </CppFiles>
    </ItemGroup>
    <Copy SourceFiles="@(CppFiles)"
      DestinationFiles="@(CppFiles->'$(PythonPackagePath)\\%(StrippedPath)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <!-- Copy *.pyi stub files and *.pyd extensions to winappsdk_<component> -->
    <ItemGroup>
      <PyiFiles Include="$(PyWinRTOutputPath)\$(PackageName)-*\**\*.pyi">
        <DestPath>$(PythonPackagePath)\$(SafePackageName)</DestPath>
      </PyiFiles>
      <PydFiles Include="$(PyWinRTOutputPath)\$(PackageName)-*\**\*.pyd">
        <DestPath>$(PythonPackagePath)\$(SafePackageName)</DestPath>
      </PydFiles>
    </ItemGroup>
    <Copy SourceFiles="@(PyiFiles)" DestinationFolder="%(PyiFiles.DestPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PydFiles)" DestinationFolder="%(PydFiles.DestPath)" SkipUnchangedFiles="true" />

    <!-- Create __init__.py for component package (winappsdk_Foundation, etc.) -->
    <WriteLinesToFile 
      File="$(PythonPackagePath)\$(SafePackageName)\__init__.py" 
      Lines="# Auto-generated package - internal extension modules" 
      Overwrite="false" 
      Encoding="UTF-8" />

    <Message Text="Will copy headers from %(ReferenceWithHeaders.PyPackageName)..."
      Importance="high" Condition="'@(ReferenceWithHeaders)' != ''" />
  </Target>

  <!-- Restructure namespace: move microsoft/* from winappsdk_* to winappsdk for unified user experience -->
  <Target Name="RestructureNamespace" DependsOnTargets="MergePyWinRTResults">
    <PropertyGroup>
      <SafePackageName>$(PackageName.Replace('-', '_'))</SafePackageName>
      <SourceMicrosoftPath>$(PythonPackagePath)\$(SafePackageName)\microsoft</SourceMicrosoftPath>
      <TargetWinappsdk>$(PythonPackagePath)\winappsdk</TargetWinappsdk>
    </PropertyGroup>

    <!-- Only restructure if microsoft folder exists (Foundation packages) -->
    <Message Text="==================== Restructuring Namespace ====================" 
      Importance="high" Condition="Exists('$(SourceMicrosoftPath)')" />
    <Message Text="Moving $(SourceMicrosoftPath) to $(TargetWinappsdk)\microsoft" 
      Importance="high" Condition="Exists('$(SourceMicrosoftPath)')" />

    <!-- Create winappsdk package structure -->
    <MakeDir Directories="$(TargetWinappsdk)" Condition="Exists('$(SourceMicrosoftPath)')" />
    
    <!-- Move microsoft folder from winappsdk_* to winappsdk -->
    <ItemGroup Condition="Exists('$(SourceMicrosoftPath)')">
      <MicrosoftFiles Include="$(SourceMicrosoftPath)\**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(MicrosoftFiles)" 
      DestinationFolder="$(TargetWinappsdk)\microsoft\%(MicrosoftFiles.RecursiveDir)" 
      SkipUnchangedFiles="true" 
      Condition="'@(MicrosoftFiles)' != ''" />
    
    <!-- Remove old microsoft folder from winappsdk_* -->
    <RemoveDir Directories="$(SourceMicrosoftPath)" Condition="Exists('$(SourceMicrosoftPath)')" />
    
    <!-- Verify the restructuring was successful -->
    <ItemGroup Condition="Exists('$(TargetWinappsdk)')">
      <WinappssdkNamespaces Include="$(TargetWinappsdk)\microsoft\**\__init__.py" />
    </ItemGroup>
    <Message Text="Namespace restructuring complete: microsoft.* is now under winappsdk.*" 
      Importance="high" Condition="Exists('$(TargetWinappsdk)')" />
    <Message Text="  Created @(WinappssdkNamespaces->Count()) namespace module(s)" 
      Importance="high" Condition="'@(WinappssdkNamespaces)' != ''" />
  </Target>


  <!-- Prepare Python package files -->
  <Target Name="GeneratePythonProjectFiles" DependsOnTargets="MergePyWinRTResults;CollectNamespaces">
    <Message Text="==================== Preparing Package Files ====================" Importance="high" />

    <Message Text="Preparing package with @(Namespace->Count()) namespace(s)" Importance="high" />
    
    <!-- Generate setup.py using generate-package.py (skip pyproject.toml since we use static one) -->
    <PropertyGroup>
      <SafePackageName>$(PackageName.Replace('-', '_'))</SafePackageName>
      <NamespaceArgs>@(Namespace->'--namespace "%(NamespaceValue)"', ' ')</NamespaceArgs>
      <GeneratePackageScript>$(ScriptsDirectory)generate-package.py</GeneratePackageScript>
    </PropertyGroup>
    
    <Message Text="Generating setup.py with $(SafePackageName) and @(Namespace->Count()) namespace(s)..." Importance="high" />
    <Message Text="Namespaces: @(Namespace->'%(NamespaceValue)', ', ')" Importance="high" />
    <Exec Command="python &quot;$(GeneratePackageScript)&quot; &quot;$(PythonPackagePath)&quot; --package-name $(SafePackageName) $(NamespaceArgs)" 
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
    
    <!-- Write version to version.txt for setuptools dynamic version -->
    <WriteLinesToFile File="$(PythonPackagePath)\version.txt" Lines="$(PyWinRTVersion)" Overwrite="true" />

    <!-- Copy static package files (pyproject.toml, README.md defined in Directory.Build.props) -->
    <Message Text="Copying static package files..." Importance="high" Condition="'@(PythonPackageFile)' != ''" />
    <Copy SourceFiles="@(PythonPackageFile)" DestinationFolder="$(PythonPackagePath)" SkipUnchangedFiles="true" Condition="'@(PythonPackageFile)' != ''" />
    <Message Text="  Copied @(PythonPackageFile->Count()) file(s)" Importance="high" Condition="'@(PythonPackageFile)' != ''" />
  </Target>

  <!-- Build the Python wheel -->
  <Target Name="GeneratePythonProject" DependsOnTargets="GeneratePythonProjectFiles">
    <Message Text="==================== Building Package ===================" Importance="high" />
    <MakeDir Directories="$(LocalWheelDirectory)" Condition="!Exists('$(LocalWheelDirectory)')" />
    <Error Text="PythonVersion property must be set in Directory.Build.props" Condition="'$(PythonVersion)' == ''" />
    
    <!-- <PropertyGroup>
      <WheelDirPath>$(LocalWheelDirectory.TrimEnd('\'))</WheelDirPath>
    </PropertyGroup> -->
    
    <!-- Build wheel using PythonVersion from Directory.Build.props with absolute find-links path -->
    <Exec Command="uv build --wheel --python $(PythonVersion) --find-links $(LocalWheelDirectory) --out-dir $(LocalWheelDirectory)" WorkingDirectory="$(PythonPackagePath)" />
  </Target>

  <!-- Clean generated files -->
  <Target Name="PyWinAppSDKClean" AfterTargets="Clean">
    <Message Text="Cleaning $(PackageName) output..." Importance="high" />
    <RemoveDir Directories="$(ObjPath)" />
  </Target>

</Project>
