r"""
Windows App SDK Composition API Demo

This demonstrates the Windows Composition API for creating visual effects,
animations, and visual elements programmatically.

The Composition API provides:
  - Lightweight visual elements
  - Smooth animations and transitions
  - GPU-accelerated rendering
  - Expression-based animations

⚠️ REQUIREMENTS:
   - Python from Microsoft Store (has package identity built-in)
   - OR use register_sparse_package.py to add package identity

Setup with Store Python:
   1. Install Python from Microsoft Store
   2. Create venv: python -m venv venv-store
   3. Activate: .\venv-store\Scripts\Activate.ps1
   4. Install: pip install --find-links wheels winappsdk-foundation winappsdk-interactiveexperiences
   5. Run: python test/composition-demo.py

Or with uv using Store Python:
   1. Find Store Python: where.exe python (look for WindowsApps path)
   2. Run: uv run --python "C:\...\WindowsApps\...\python.exe" composition-demo.py

Run:
    python composition-demo.py
"""

import sys
import time
import math
import ctypes
from ctypes import wintypes
import tkinter as tk
import threading

# Import Windows App SDK bootstrap
from winappsdk.bootstrap import initialize_windows_app_sdk, BootstrapInitializeOptions

# Import Composition APIs
from winappsdk.microsoft.ui.composition import (
    Compositor,
    ContainerVisual,
    SpriteVisual,
    ColorKeyFrameAnimation,
    ScalarKeyFrameAnimation,
    Vector3KeyFrameAnimation,
    CompositionEasingFunction,
    CompositionColorBrush,
    DropShadow,
    AnimationIterationBehavior,
)

# Import dispatcher queue
from winappsdk.microsoft.ui.dispatching import DispatcherQueueController

# Import color and numerics support
from winrt.windows.ui import Color
import winrt.windows.foundation.numerics as numerics
import datetime

# Win32 API constants and structures
WS_OVERLAPPEDWINDOW = 0x00CF0000
WS_VISIBLE = 0x10000000
CW_USEDEFAULT = ctypes.c_int(0x80000000).value  # Properly handle negative int
SW_SHOW = 5
WM_DESTROY = 0x0002
WM_PAINT = 0x000F
WM_QUIT = 0x0012
WM_TIMER = 0x0113
PM_REMOVE = 0x0001
WHITE_BRUSH = 0

# Load Windows DLLs
user32 = ctypes.windll.user32
kernel32 = ctypes.windll.kernel32
gdi32 = ctypes.windll.gdi32

# Define WNDPROC callback type
WNDPROC = ctypes.WINFUNCTYPE(wintypes.LPARAM, wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM)

# GDI structures
class RECT(ctypes.Structure):
    _fields_ = [
        ("left", wintypes.LONG),
        ("top", wintypes.LONG),
        ("right", wintypes.LONG),
        ("bottom", wintypes.LONG),
    ]

class PAINTSTRUCT(ctypes.Structure):
    _fields_ = [
        ("hdc", wintypes.HDC),
        ("fErase", wintypes.BOOL),
        ("rcPaint", RECT),
        ("fRestore", wintypes.BOOL),
        ("fIncUpdate", wintypes.BOOL),
        ("rgbReserved", wintypes.BYTE * 32),
    ]

# Define structures
class WNDCLASSEXW(ctypes.Structure):
    _fields_ = [
        ("cbSize", wintypes.UINT),
        ("style", wintypes.UINT),
        ("lpfnWndProc", WNDPROC),
        ("cbClsExtra", ctypes.c_int),
        ("cbWndExtra", ctypes.c_int),
        ("hInstance", wintypes.HINSTANCE),
        ("hIcon", wintypes.HANDLE),
        ("hCursor", wintypes.HANDLE),
        ("hbrBackground", wintypes.HANDLE),
        ("lpszMenuName", wintypes.LPCWSTR),
        ("lpszClassName", wintypes.LPCWSTR),
        ("hIconSm", wintypes.HANDLE),
    ]

class POINT(ctypes.Structure):
    _fields_ = [("x", wintypes.LONG), ("y", wintypes.LONG)]

class MSG(ctypes.Structure):
    _fields_ = [
        ("hwnd", wintypes.HWND),
        ("message", wintypes.UINT),
        ("wParam", wintypes.WPARAM),
        ("lParam", wintypes.LPARAM),
        ("time", wintypes.DWORD),
        ("pt", POINT),
    ]


def demo_compositor_creation():
    """Demonstrate creating a Compositor instance."""
    print("\n[1] Creating Compositor...")
    print("    The Compositor is the factory for creating composition objects.")
    
    try:
        compositor = Compositor()
        print(f"✅ Compositor created successfully!")
        print(f"    Type: {type(compositor)}")
        return compositor
    except Exception as e:
        print(f"❌ Error creating Compositor: {e}")
        return None


def demo_visual_creation(compositor):
    """Demonstrate creating visual elements."""
    print("\n[2] Creating Visual Elements...")
    print("    Visuals are the building blocks of composition UI.")
    
    try:
        # Create a container visual
        container = compositor.create_container_visual()
        print(f"✅ ContainerVisual created")
        print(f"    Can hold multiple child visuals")
        
        # Create sprite visuals (rectangles with colors)
        sprite1 = compositor.create_sprite_visual()
        sprite1.size = numerics.Vector2(100.0, 100.0)
        sprite1.offset = numerics.Vector3(50.0, 50.0, 0.0)
        print(f"✅ SpriteVisual 1 created at (50, 50) with size 100x100")
        
        sprite2 = compositor.create_sprite_visual()
        sprite2.size = numerics.Vector2(150.0, 75.0)
        sprite2.offset = numerics.Vector3(200.0, 100.0, 0.0)
        print(f"✅ SpriteVisual 2 created at (200, 100) with size 150x75")
        
        # Add sprites to container
        container.children.insert_at_top(sprite1)
        container.children.insert_at_top(sprite2)
        print(f"✅ Visuals added to container")
        print(f"    Container now has {container.children.count} children")
        
        return container, sprite1, sprite2
    except Exception as e:
        print(f"❌ Error creating visuals: {e}")
        return None, None, None


def demo_brushes_and_colors(compositor, sprite1, sprite2):
    """Demonstrate creating and applying brushes and colors."""
    print("\n[3] Creating Brushes and Applying Colors...")
    print("    Brushes define how visuals are painted.")
    
    try:
        # Create solid color brushes
        # Color(A, R, G, B) - Crimson is RGB(220, 20, 60)
        red_brush = compositor.create_color_brush_with_color(Color(255, 220, 20, 60))
        sprite1.brush = red_brush
        print(f"✅ Red brush applied to sprite 1 (Crimson)")
        
        # RoyalBlue is RGB(65, 105, 225)
        blue_brush = compositor.create_color_brush_with_color(Color(255, 65, 105, 225))
        sprite2.brush = blue_brush
        print(f"✅ Blue brush applied to sprite 2 (RoyalBlue)")
        
        # Demonstrate changing opacity
        sprite1.opacity = 0.8
        sprite2.opacity = 0.9
        print(f"✅ Opacity set: sprite1=0.8, sprite2=0.9")
        
        return red_brush, blue_brush
    except Exception as e:
        print(f"❌ Error with brushes: {e}")
        return None, None


def demo_drop_shadows(compositor, sprite1, sprite2):
    """Demonstrate creating drop shadows."""
    print("\n[4] Creating Drop Shadows...")
    print("    Shadows add depth to visual elements.")
    
    try:
        # Create shadow for sprite1
        shadow1 = compositor.create_drop_shadow()
        # Black is RGB(0, 0, 0)
        shadow1.color = Color(255, 0, 0, 0)
        shadow1.blur_radius = 20.0
        shadow1.opacity = 0.5
        shadow1.offset = numerics.Vector3(5.0, 5.0, 0.0)
        sprite1.shadow = shadow1
        print(f"✅ Drop shadow added to sprite 1")
        print(f"    Blur: 20px, Opacity: 0.5, Offset: (5, 5)")
        
        # Create shadow for sprite2
        shadow2 = compositor.create_drop_shadow()
        # DarkBlue is RGB(0, 0, 139)
        shadow2.color = Color(255, 0, 0, 139)
        shadow2.blur_radius = 30.0
        shadow2.opacity = 0.7
        shadow2.offset = numerics.Vector3(8.0, 8.0, 0.0)
        sprite2.shadow = shadow2
        print(f"✅ Drop shadow added to sprite 2")
        print(f"    Blur: 30px, Opacity: 0.7, Offset: (8, 8)")
        
        return shadow1, shadow2
    except Exception as e:
        print(f"❌ Error creating shadows: {e}")
        return None, None


def demo_color_animation(compositor, red_brush):
    """Demonstrate color animation."""
    print("\n[5] Creating Color Animation...")
    print("    Animate colors smoothly over time.")
    
    try:
        # Create color animation
        color_animation = compositor.create_color_key_frame_animation()
        # Duration in 100-nanosecond units (3 seconds = 3 * 10^7)
        color_animation.duration = datetime.timedelta(seconds=3)
        
        # Add keyframes - Crimson RGB(220, 20, 60), Gold RGB(255, 215, 0)
        color_animation.insert_key_frame(0.0, Color(255, 220, 20, 60))
        color_animation.insert_key_frame(0.5, Color(255, 255, 215, 0))
        color_animation.insert_key_frame(1.0, Color(255, 220, 20, 60))
        
        # Set iteration behavior
        color_animation.iteration_behavior = AnimationIterationBehavior.FOREVER
        
        print(f"✅ Color animation created")
        print(f"    Duration: 3 seconds")
        print(f"    KeyFrames: Crimson -> Gold -> Crimson")
        print(f"    Iteration: Forever")
        
        # Start animation
        red_brush.start_animation("Color", color_animation)
        print(f"✅ Animation started on red brush")
        
        return color_animation
    except Exception as e:
        print(f"❌ Error creating color animation: {e}")
        return None


def demo_scale_animation(compositor, sprite2):
    """Demonstrate scale animation."""
    print("\n[6] Creating Scale Animation...")
    print("    Animate visual size smoothly.")
    
    try:
        # Create scale animation
        scale_animation = compositor.create_vector3_key_frame_animation()
        scale_animation.duration = datetime.timedelta(seconds=2)
        
        # Add keyframes (easing is optional)
        scale_animation.insert_key_frame(0.0, numerics.Vector3(1.0, 1.0, 1.0))
        scale_animation.insert_key_frame(0.5, numerics.Vector3(1.5, 1.5, 1.0))
        scale_animation.insert_key_frame(1.0, numerics.Vector3(1.0, 1.0, 1.0))
        
        # Set iteration behavior
        scale_animation.iteration_behavior = AnimationIterationBehavior.FOREVER
        
        print(f"✅ Scale animation created")
        print(f"    Duration: 2 seconds")
        print(f"    Scale: 1.0 -> 1.5 -> 1.0")
        print(f"    Interpolation: Linear")
        
        # Start animation
        sprite2.start_animation("Scale", scale_animation)
        print(f"✅ Animation started on sprite 2")
        
        return scale_animation
    except Exception as e:
        print(f"❌ Error creating scale animation: {e}")
        return None


def demo_rotation_animation(compositor, sprite1):
    """Demonstrate rotation animation."""
    print("\n[7] Creating Rotation Animation...")
    print("    Rotate visuals continuously.")
    
    try:
        # Create rotation animation (in radians)
        rotation_animation = compositor.create_scalar_key_frame_animation()
        rotation_animation.duration = datetime.timedelta(seconds=4)
        
        # Rotate from 0 to 360 degrees (converted to radians)
        rotation_animation.insert_key_frame(0.0, 0.0)
        rotation_animation.insert_key_frame(1.0, 360.0 * (math.pi / 180.0))  # Full rotation in radians
        
        # Loop forever
        rotation_animation.iteration_behavior = AnimationIterationBehavior.FOREVER
        
        print(f"✅ Rotation animation created")
        print(f"    Duration: 4 seconds per rotation")
        print(f"    Rotation: 0° -> 360°")
        print(f"    Iteration: Forever")
        
        # Set rotation axis (center of visual)
        sprite1.center_point = numerics.Vector3(50.0, 50.0, 0.0)
        
        # Start animation
        sprite1.start_animation("RotationAngle", rotation_animation)
        print(f"✅ Animation started on sprite 1")
        
        return rotation_animation
    except Exception as e:
        print(f"❌ Error creating rotation animation: {e}")
        return None


def demo_expression_animation(compositor, sprite1, sprite2):
    """Demonstrate expression-based animation."""
    print("\n[8] Creating Expression Animation...")
    print("    Use mathematical expressions to link properties.")
    
    try:
        # Create expression animation that links sprite2 position to sprite1
        expression_anim = compositor.create_expression_animation()
        expression_anim.expression = "Vector3(sprite1.Offset.X + 150, sprite1.Offset.Y, 0)"
        expression_anim.set_reference_parameter("sprite1", sprite1)
        
        print(f"✅ Expression animation created")
        print(f"    Expression: sprite2.X follows sprite1.X + 150")
        print(f"    This creates a linked movement effect")
        
        # Note: We're not starting this animation to keep the demo simple,
        # but it would be started like: sprite2.start_animation("Offset", expression_anim)
        print(f"ℹ️  Expression animation demonstrated (not started)")
        
        return expression_anim
    except Exception as e:
        print(f"❌ Error creating expression animation: {e}")
        return None


def demo_animation_properties():
    """Display information about animation properties."""
    print("\n[9] Animatable Properties Reference...")
    print("    Common properties that can be animated:")
    print("    • Offset          - Position (Vector3)")
    print("    • Size            - Dimensions (Vector2)")
    print("    • Scale           - Scale factor (Vector3)")
    print("    • Opacity         - Transparency (Scalar 0-1)")
    print("    • RotationAngle   - Rotation (Scalar in radians)")
    print("    • CenterPoint     - Rotation/scale center (Vector3)")
    print("    • Color           - Brush color (Color)")
    print("    • Offset (Shadow) - Shadow offset (Vector3)")
    print("    • BlurRadius      - Shadow blur (Scalar)")


def create_visualization_window():
    """Create a Tkinter window to visualize the animations."""
    print("\n[10] Creating Visualization Window...")
    print("    Opening window to simulate the composition animations...")
    
    root = tk.Tk()
    root.title("🎨 Composition API Demo - Animation Visualization")
    root.geometry("800x600")
    root.configure(bg='#f0f0f0')
    
    canvas = tk.Canvas(root, width=800, height=600, bg='#f0f0f0', highlightthickness=0)
    canvas.pack()
    
    # Animation state
    start_time = time.time()
    
    # Sprite info
    sprite1 = {'x': 50, 'y': 50, 'w': 100, 'h': 100}
    sprite2 = {'x': 200, 'y': 100, 'w': 150, 'h': 75}
    
    def animate():
        nonlocal start_time
        current_time = time.time() - start_time
        
        # Clear canvas
        canvas.delete("all")
        
        # Draw title
        canvas.create_text(400, 20, text=f"🎨 Composition API Demo - Time: {current_time:.1f}s", 
                          font=("Arial", 14, "bold"), fill="#333")
        
        # Sprite 1: Color animation + Rotation
        t_color = (current_time % 3) / 3
        if t_color < 0.5:
            # Crimson to Gold
            mix = t_color * 2
            r = int(220 + (255 - 220) * mix)
            g = int(20 + (215 - 20) * mix)
            b = int(60 + (0 - 60) * mix)
        else:
            # Gold to Crimson
            mix = (t_color - 0.5) * 2
            r = int(255 + (220 - 255) * mix)
            g = int(215 + (20 - 215) * mix)
            b = int(0 + (60 - 0) * mix)
        
        color1 = f'#{r:02x}{g:02x}{b:02x}'
        
        # Rotation angle (4 second cycle)
        angle = (current_time % 4) / 4 * 360
        
        # Draw sprite1 with shadow and rotation effect
        shadow_offset = 5
        canvas.create_rectangle(
            sprite1['x'] + shadow_offset, sprite1['y'] + shadow_offset,
            sprite1['x'] + sprite1['w'] + shadow_offset, sprite1['y'] + sprite1['h'] + shadow_offset,
            fill='#404040', outline='')
        canvas.create_rectangle(
            sprite1['x'], sprite1['y'],
            sprite1['x'] + sprite1['w'], sprite1['y'] + sprite1['h'],
            fill=color1, outline='#000', width=2)
        canvas.create_text(sprite1['x'] + sprite1['w']//2, sprite1['y'] + sprite1['h']//2,
                          text=f"↻ {angle:.0f}°", font=("Arial", 12, "bold"), fill='white')
        
        # Sprite 2: Scale animation
        t_scale = (current_time % 2) / 2
        scale = 1.0 + 0.5 * (1 - abs(2 * t_scale - 1))  # 1.0 -> 1.5 -> 1.0
        w2 = int(sprite2['w'] * scale)
        h2 = int(sprite2['h'] * scale)
        
        # Draw sprite2 with shadow and scaling
        canvas.create_rectangle(
            sprite2['x'] + 8, sprite2['y'] + 8,
            sprite2['x'] + w2 + 8, sprite2['y'] + h2 + 8,
            fill='#003080', outline='')
        canvas.create_rectangle(
            sprite2['x'], sprite2['y'],
            sprite2['x'] + w2, sprite2['y'] + h2,
            fill='#4169E1', outline='#000', width=2)
        canvas.create_text(sprite2['x'] + w2//2, sprite2['y'] + h2//2,
                          text=f"⇔ {scale:.2f}x", font=("Arial", 12, "bold"), fill='white')
        
        # Draw info text
        info_lines = [
            "Red square: Color animation (Crimson ↔ Gold, 3s) + Rotation (360°, 4s)",
            "Blue rectangle: Scale animation (1.0x ↔ 1.5x, 2s)",
            "Both have drop shadows with blur effects"
        ]
        y_offset = 520
        for line in info_lines:
            canvas.create_text(400, y_offset, text=line, font=("Arial", 10), fill="#666")
            y_offset += 20
        
        # Continue animation if window is still open
        if current_time < 20:  # Run for 20 seconds
            root.after(16, animate)  # ~60 FPS
        else:
            canvas.create_text(400, 300, text="Demo Complete! (Close window to exit)",
                             font=("Arial", 16, "bold"), fill="#d00")
    
    print("✅ Window created successfully!")
    print("   Simulating composition animations at 60 FPS")
    print("   Watch the animations for 20 seconds...\n")
    
    # Start animation
    animate()
    
    # Run the window
    root.mainloop()
    print("✅ Window closed")


def main():
    """Create a Win32 window to visualize the composition."""
    global sprites_info, wnd_proc_func
    
    print("\n[10] Creating Visualization Window...")
    print("    Opening a window to display the animations...")
    
    # Store sprite info for rendering
    sprites_info = [
        {'pos': (50, 50), 'size': (100, 100), 'color': (220, 20, 60), 'name': 'sprite1'},
        {'pos': (200, 100), 'size': (150, 75), 'color': (65, 105, 225), 'name': 'sprite2'},
    ]
    
    # Window procedure callback
    @WNDPROC
    def wnd_proc(hwnd, msg, wparam, lparam):
        global animation_time
        
        if msg == WM_DESTROY:
            user32.PostQuitMessage(0)
            return 0
        elif msg == WM_PAINT:
            # Paint the window
            ps = PAINTSTRUCT()
            hdc = user32.BeginPaint(hwnd, ctypes.byref(ps))
            
            # Draw background
            rect = RECT()
            user32.GetClientRect(hwnd, ctypes.byref(rect))
            
            # Fill background with light gray
            bg_brush = gdi32.CreateSolidBrush(0x00F0F0F0)
            user32.FillRect(hdc, ctypes.byref(rect), bg_brush)
            gdi32.DeleteObject(bg_brush)
            
            # Draw sprites with animated effects
            for i, sprite in enumerate(sprites_info):
                x, y = sprite['pos']
                w, h = sprite['size']
                r, g, b = sprite['color']
                
                # Apply animations
                if i == 0:  # sprite1 - rotation
                    angle = animation_time * 360 / 4  # 4 second rotation
                    # For simplicity, just show it pulsing
                    scale = 1.0
                else:  # sprite2 - scale
                    t = (animation_time % 2) / 2  # 2 second cycle
                    scale = 1.0 + 0.5 * (1 - abs(2 * t - 1))  # 1.0 -> 1.5 -> 1.0
                    w = int(w * scale)
                    h = int(h * scale)
                
                # Color animation (approximate)
                if i == 0:
                    t = (animation_time % 3) / 3  # 3 second cycle
                    if t < 0.5:
                        # Crimson to Gold
                        mix = t * 2
                        r = int(220 + (255 - 220) * mix)
                        g = int(20 + (215 - 20) * mix)
                        b = int(60 + (0 - 60) * mix)
                    else:
                        # Gold to Crimson
                        mix = (t - 0.5) * 2
                        r = int(255 + (220 - 255) * mix)
                        g = int(215 + (20 - 215) * mix)
                        b = int(0 + (60 - 0) * mix)
                
                # Draw rectangle with shadow
                # Shadow
                shadow_brush = gdi32.CreateSolidBrush(0x00404040)
                shadow_rect = RECT(x + 5, y + 5, x + w + 5, y + h + 5)
                user32.FillRect(hdc, ctypes.byref(shadow_rect), shadow_brush)
                gdi32.DeleteObject(shadow_brush)
                
                # Main rectangle
                color_win = (b << 16) | (g << 8) | r  # BGR format
                brush = gdi32.CreateSolidBrush(color_win)
                sprite_rect = RECT(x, y, x + w, y + h)
                user32.FillRect(hdc, ctypes.byref(sprite_rect), brush)
                gdi32.DeleteObject(brush)
            
            # Draw info text
            text = f"🎨 Composition Demo - Time: {animation_time:.1f}s"
            text_rect = RECT(10, 10, rect.right, 40)
            user32.DrawTextW(hdc, text, -1, ctypes.byref(text_rect), 0)
            
            info_text = "Red sprite: Rotating + Color animation (Crimson↔Gold) | Blue sprite: Scaling (1.0↔1.5)"
            info_rect = RECT(10, rect.bottom - 40, rect.right, rect.bottom)
            user32.DrawTextW(hdc, info_text, -1, ctypes.byref(info_rect), 0)
            
            user32.EndPaint(hwnd, ctypes.byref(ps))
            return 0
        elif msg == WM_TIMER:
            # Update animation
            animation_time += 0.016  # ~60 FPS
            user32.InvalidateRect(hwnd, 0, False)
            return 0
        
        # For other messages, just return 0 to avoid ctypes argument issues
        # In a production app, you'd properly handle DefWindowProcW
        return 0
    
    # Keep reference to prevent GC
    wnd_proc_func = wnd_proc
    
    # Register window class with timestamp to make it unique
    import random
    class_name = f"CompositionDemoWindow{random.randint(1000,9999)}"
    h_instance = kernel32.GetModuleHandleW(None)
    
    wc = WNDCLASSEXW()
    wc.cbSize = ctypes.sizeof(WNDCLASSEXW)
    wc.lpfnWndProc = wnd_proc_func
    wc.hInstance = h_instance
    wc.lpszClassName = class_name
    wc.hCursor = user32.LoadCursorW(0, 32512)  # IDC_ARROW
    wc.hbrBackground = WHITE_BRUSH
    wc.style = 0
    wc.cbClsExtra = 0
    wc.cbWndExtra = 0
    wc.hIcon = 0
    wc.lpszMenuName = 0
    wc.hIconSm = 0
    
    atom = user32.RegisterClassExW(ctypes.byref(wc))
    if not atom:
        error = kernel32.GetLastError()
        print(f"❌ Failed to register window class (error: {error})")
        return None
    
    print(f"   Class registered successfully!")
    
    # Create window using class name (not atom)
    hwnd = user32.CreateWindowExW(
        0,  # dwExStyle
        class_name,  # lpClassName
        "Composition API Demo",  # lpWindowName
        WS_OVERLAPPEDWINDOW | WS_VISIBLE,  # dwStyle
        100, 100,  # x, y
        800, 600,  # width, height
        0, 0,  # hWndParent, hMenu
        h_instance,  # hInstance
        0  # lpParam
    )
    
    if not hwnd:
        error = kernel32.GetLastError()
        print(f"❌ Failed to create window (error: {error})")
        return None
    
    print(f"✅ Window created successfully!")
    print(f"   Rendering composition animations with GDI simulation")
    
    user32.ShowWindow(hwnd, SW_SHOW)
    user32.UpdateWindow(hwnd)
    
    # Set up timer for animation updates (60 FPS)
    user32.SetTimer(hwnd, 1, 16, None)
    
    return hwnd


def run_message_loop(hwnd, duration=15):
    """Run Windows message loop for specified duration."""
    print(f"\n▶️  Animation window active...")
    
    msg = MSG()
    start_time = time.time()
    
    while True:Create visualization window
        create_visualization_window(
            if msg.message == WM_QUIT:
                break
            user32.TranslateMessage(ctypes.byref(msg))
            user32.DispatchMessageW(ctypes.byref(msg))
        else:
            # Small sleep to prevent CPU spinning
            time.sleep(0.001)
    
    print(f"✅ Window closed")


def main():
    """Main demo function."""
    print("=" * 70)
    print("🎨 Windows App SDK Composition API Demo")
    print("=" * 70)
    print("\nThis demo showcases the Windows Composition API:")
    print("  • Creating Compositor and Visual elements")
        print(f"  • Visualized animations in Tkinter window!")
        
        print("\nℹ️  Technical Note:")
        print("   The actual composition objects run in GPU memory managed by")
        print("   the Windows Composition Engine. The Tkinter window simulates")
        print("   what the animations would look like if properly connected via:")
        print("   - ICompositorDesktopInterop (COM interop)")
        print("   - WinUI 3 with composition surfaces")
        print("   - DirectComposition/DWM integration")
        
        print("\n💡 Next Steps:")
        print("   - Explore InteractionTracker for touch/pointer animations")
        print("   - Combine with WinUI 3 for visual rendering")
        print("   - Create complex visual effects and transitions")
        print("   - Build custom controls with smooth animations")
        
    except Exception as e:
        print(f"\n❌ Error in demo: {e}")
        import traceback
        traceback.print_exc()
        raise


