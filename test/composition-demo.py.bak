def run_demos():
    """Run all composition demos (called within Windows App SDK context)."""
    try:
        # Initialize DispatcherQueue (required for Composition API)
        print("\n[Initializing DispatcherQueue...]")
        controller = DispatcherQueueController.create_on_current_thread()
        print("✅ DispatcherQueue initialized successfully")
        
        # Demo 1: Create compositor
        compositor = demo_compositor_creation()
        if not compositor:
            return 1
        
        # Demo 2: Create visuals
        container, sprite1, sprite2 = demo_visual_creation(compositor)
        if not all([container, sprite1, sprite2]):
            return 1
        
        # Demo 3: Brushes and colors
        red_brush, blue_brush = demo_brushes_and_colors(compositor, sprite1, sprite2)
        
        # Demo 4: Drop shadows
        shadow1, shadow2 = demo_drop_shadows(compositor, sprite1, sprite2)
        
        # Demo 5: Color animation
        color_anim = demo_color_animation(compositor, red_brush)
        
        # Demo 6: Scale animation
        scale_anim = demo_scale_animation(compositor, sprite2)
        
        # Demo 7: Rotation animation
        rotation_anim = demo_rotation_animation(compositor, sprite1)
        
        # Demo 8: Expression animation
        expr_anim = demo_expression_animation(compositor, sprite1, sprite2)
        
        # Demo 9: Properties reference
        demo_animation_properties()
        
        # Demo 10: Display animation information
        print("\n[10] Composition Animations Active!")
        print("     All animations are now running in memory:")
        print("     • Color animation on red brush (Crimson ↔ Gold)")
        print("     • Scale animation on blue sprite (1.0 ↔ 1.5)")
        print("     • Rotation animation on red sprite (360° continuous)")
        print("\n     Note: To see these animations visually, they would need")
        print("     to be connected to a window surface using COM interop.")
        print("     The full demo with WinUI3 would show the actual rendering.")
        
        print("\n" + "=" * 70)
        print("✅ All Composition API demos completed successfully!")
        print("=" * 70)
        
        print("\n📊 Demo Summary:")
        print(f"  • Created 1 Compositor")
        print(f"  • Created 3 Visuals (1 container, 2 sprites)")
        print(f"  • Applied 2 Brushes with Colors")
        print(f"  • Added 2 Drop Shadows with blur effects")
        print(f"  • Created 4 Animations (color, scale, rotation, expression)")
        print(f"  • All animations are active and running!")
        
        print("\nℹ️  Technical Note:")
        print("   These composition objects exist in GPU memory and are")
        print("   managed by the Windows Composition Engine. To render them")
        print("   visually requires connecting to a window via:")
        print("   - ICompositorDesktopInterop (COM interop)")
        print("   - WinUI 3 with XAML Islands")
        print("   - Win32 HWND with composition surfaces")
        
        print("\n💡 Next Steps:")
        print("   - Explore InteractionTracker for touch/pointer animations")
        print("   - Combine with WinUI 3 for visual rendering")
        print("   - Create complex visual effects and transitions")
        print("   - Build custom controls with smooth animations")
        
    except Exception as e:
        print(f"\n❌ Error in demo: {e}")
        import traceback
        traceback.print_exc()
        raise


if __name__ == "__main__":
    sys.exit(main())
