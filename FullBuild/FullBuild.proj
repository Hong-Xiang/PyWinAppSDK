<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <Target Name="Build">
    <Message Text="Building Component Packages..." Importance="high" />

    <!-- Build Components in Parallel -->
    <ItemGroup>
      <ComponentProjects Include="..\AI\PyWinRT.Microsoft.WindowsAppSDK.AI.proj" />
      <ComponentProjects Include="..\Foundation\PyWinRT.Microsoft.WindowsAppSDK.Foundation.proj" />
      <ComponentProjects Include="..\InteractiveExperiences\InteractiveExperiences.proj" />
    </ItemGroup>
    <MSBuild Projects="@(ComponentProjects)" 
             Targets="Build" 
             Properties="Configuration=$(Configuration);GeneratePyWinAppSDK=true" 
             BuildInParallel="true" />
             
    <Message Text="Component Package Build Completed Successfully." Importance="high" />
  </Target>

  <Target Name="Clean">
    <Message Text="Cleaning component projects..." Importance="high" />
    <ItemGroup>
      <ComponentProjects Include="..\AI\PyWinRT.Microsoft.WindowsAppSDK.AI.proj" />
      <ComponentProjects Include="..\Foundation\PyWinRT.Microsoft.WindowsAppSDK.Foundation.proj" />
      <ComponentProjects Include="..\InteractiveExperiences\InteractiveExperiences.proj" />
    </ItemGroup>
    <MSBuild Projects="@(ComponentProjects)" Targets="Clean" Properties="Configuration=$(Configuration)" BuildInParallel="true" />
  </Target>
</Project>
