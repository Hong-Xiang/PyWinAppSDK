<Project Sdk="Microsoft.Build.NoTargets">
  <!--
    PyWinRT Python package for Microsoft.WindowsAppSDK.InteractiveExperiences
    
    This is the base package with no dependencies on other winappsdk packages.
  -->

  <PropertyGroup>
    <PackageName>winappsdk-InteractiveExperiences</PackageName>
  </PropertyGroup>

  <!-- Trigger Python package generation after Build -->
  <Target Name="BuildPythonPackage" AfterTargets="Build" DependsOnTargets="GeneratePythonProject" />

  <ItemGroup>
    <!-- NuGet Package References -->
    <PackageReference Include="Microsoft.Windows.SDK.CPP" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" GeneratePathProperty="true" />
    <PackageDownload Include="PyWinRT" Version="[$(PyWinRTVersion)]" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    
    <!-- Build tasks for WinMD resolution -->
    <PackageReference Include="PyWinAppSDK.Build.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <!-- Resolve WinMD files dynamically using ResolveWinMDReferences -->
  <Target Name="ResolveComponentWinMDs" BeforeTargets="BuildWinMDArguments">
    <ResolveWinMDReferences
      AssetsFilePath="$(ProjectAssetsFile)"
      InputPackages="Microsoft.WindowsAppSDK.InteractiveExperiences"
      ExcludePackages="Microsoft.Windows.SDK.CPP"
      WinMDFolders="@(WinMDFolder)">
      <Output TaskParameter="InputWinMD" ItemName="ResolvedInputWinMD" />
      <Output TaskParameter="ReferencedWinMD" ItemName="ResolvedReferencedWinMD" />
    </ResolveWinMDReferences>

    <!-- Set up InputWinMD from resolved items -->
    <ItemGroup>
      <InputWinMD Include="@(ResolvedInputWinMD)">
        <PyPackageName>$(PackageName)</PyPackageName>
      </InputWinMD>
      <ReferenceWinMD Include="@(ResolvedReferencedWinMD)">
        <PyPackageName>winappsdk</PyPackageName>
      </ReferenceWinMD>
    </ItemGroup>
  </Target>

  <!-- Python runtime dependencies (required for type marshalling at runtime) -->
  <ItemGroup>
    <PythonDependency Include="winrt-Windows.Foundation" />
    <PythonDependency Include="winrt-Windows.Foundation.Collections" />
  </ItemGroup>

</Project>