<Project Sdk="Microsoft.Build.NoTargets">
  <!--
    PyWinRT Python package for Microsoft.WindowsAppSDK.Foundation
    
    Depends on winappsdk-InteractiveExperiences.
  -->

  <PropertyGroup>
    <PackageName>winappsdk-Foundation</PackageName>
  </PropertyGroup>

  <!-- Trigger Python package generation after Build -->
  <Target Name="BuildPythonPackage" AfterTargets="Build" DependsOnTargets="GeneratePythonProject" />

  <ItemGroup>
    <!-- NuGet Package References -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.SDK.CPP" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" GeneratePathProperty="true" />
    <PackageDownload Include="PyWinRT" Version="[$(PyWinRTVersion)]" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    
    <!-- Build tasks for WinMD resolution -->
    <PackageReference Include="PyWinAppSDK.Build.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <!-- Resolve WinMD files dynamically using ResolveWinMDReferences -->
  <Target Name="ResolveComponentWinMDs" BeforeTargets="BuildWinMDArguments">
    <ResolveWinMDReferences
      AssetsFilePath="$(ProjectAssetsFile)"
      InputPackages="Microsoft.WindowsAppSDK.Foundation"
      ExcludePackages="Microsoft.Windows.SDK.CPP"
      WinMDFolders="@(WinMDFolder)">
      <Output TaskParameter="InputWinMD" ItemName="ResolvedInputWinMD" />
      <Output TaskParameter="ReferencedWinMD" ItemName="ResolvedReferencedWinMD" />
    </ResolveWinMDReferences>

    <!-- Set up InputWinMD and ReferenceWinMD from resolved items -->
    <ItemGroup>
      <InputWinMD Include="@(ResolvedInputWinMD)">
        <PyPackageName>$(PackageName)</PyPackageName>
      </InputWinMD>
      <ReferenceWinMD Include="@(ResolvedReferencedWinMD)">
        <PyPackageName>winappsdk</PyPackageName>
      </ReferenceWinMD>
    </ItemGroup>
  </Target>

  <!-- Python runtime dependencies (required for type marshalling at runtime) -->
  <ItemGroup>
    <PythonDependency Include="winappsdk-InteractiveExperiences" />
    <PythonDependency Include="winrt-Windows.Foundation" />
    <PythonDependency Include="winrt-Windows.Foundation.Collections" />
    <PythonDependency Include="winrt-Windows.Storage" />
  </ItemGroup>

  <!--  
    Copy Windows App SDK Bootstrap DLL to package for all architectures.
    This allows Python code to initialize the runtime without manual DLL discovery.
  -->
  <Target Name="CopyBootstrapDLLs" AfterTargets="GeneratePythonProjectFiles">
    <PropertyGroup>
      <BootstrapSourcePath>$(PkgMicrosoft_WindowsAppSDK_Foundation)\runtimes</BootstrapSourcePath>
      <BootstrapDestPath>$(PythonPackagePath)\winappsdk</BootstrapDestPath>
    </PropertyGroup>

    <Message Text="Copying Windows App SDK Bootstrap DLLs..." Importance="high" />
    
    <!-- Copy DLL for each architecture -->
    <ItemGroup>
      <BootstrapDLL Include="$(BootstrapSourcePath)\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll">
        <TargetArch>win-x64</TargetArch>
      </BootstrapDLL>
      <BootstrapDLL Include="$(BootstrapSourcePath)\win-x86\native\Microsoft.WindowsAppRuntime.Bootstrap.dll">
        <TargetArch>win-x86</TargetArch>
      </BootstrapDLL>
      <BootstrapDLL Include="$(BootstrapSourcePath)\win-arm64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll">
        <TargetArch>win-arm64</TargetArch>
      </BootstrapDLL>
    </ItemGroup>

    <!-- Create architecture-specific folders and copy DLLs -->
    <MakeDir Directories="$(BootstrapDestPath)\%(BootstrapDLL.TargetArch)" />
    <Copy SourceFiles="%(BootstrapDLL.Identity)" 
          DestinationFolder="$(BootstrapDestPath)\%(BootstrapDLL.TargetArch)" 
          SkipUnchangedFiles="true" 
          Condition="Exists('%(BootstrapDLL.Identity)')" />
    
    <Message Text="  Copied %(BootstrapDLL.TargetArch)\Microsoft.WindowsAppRuntime.Bootstrap.dll" 
             Importance="high" 
             Condition="Exists('%(BootstrapDLL.Identity)')" />
  </Target>

  <!-- Copy Bootstrap Python module to package -->
  <Target Name="CopyBootstrapModule" AfterTargets="CopyBootstrapDLLs">
    <PropertyGroup>
      <BootstrapSourceDir>$(MSBuildProjectDirectory)\winappsdk\bootstrap</BootstrapSourceDir>
    </PropertyGroup>
    
    <Message Text="Copying Bootstrap Python module..." Importance="high" />
    <Message Text="  Source: $(BootstrapSourceDir)" Importance="high" />
    <Message Text="  Dest: $(PythonPackagePath)\winappsdk\bootstrap" Importance="high" />
    
    <!-- Copy the bootstrap folder with all its contents -->
    <ItemGroup>
      <BootstrapPyFiles Include="$(BootstrapSourceDir)\**\*.*" />
    </ItemGroup>
    
    <Message Text="  Found @(BootstrapPyFiles->Count()) file(s) to copy" Importance="high" />
    
    <Copy SourceFiles="@(BootstrapPyFiles)" 
          DestinationFolder="$(PythonPackagePath)\winappsdk\bootstrap\%(RecursiveDir)" 
          SkipUnchangedFiles="true" />
    
    <Message Text="  ✓ Copied bootstrap module to package" Importance="high" />
  </Target>

</Project>